generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  emailMessages EmailMessage[]
  oauthSessions OAuthSession[]
  projects      Project[]
  sessions      Session[]

  @@map("users")
}

model Project {
  id              String          @id @default(cuid())
  name            String
  description     String?
  status          ProjectStatus   @default(ACTIVE)
  startDate       DateTime
  endDate         DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  contractor      String?
  budget          Float?
  address         String?
  addressPlaceId  String?
  addressLat      Float?
  addressLng      Float?
  userId          String
  emailAnalyses   EmailAnalysis[]
  emailMessages   EmailMessage[]
  emailSettings   EmailSettings?
  flaggedItems    FlaggedItem[]
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamMembers     TeamMember[]
  timelineEntries TimelineEntry[]

  @@map("projects")
}

model FlaggedItem {
  id                 String              @id @default(cuid())
  title              String
  description        String
  impact             String
  category           FlaggedItemCategory
  emailFrom          String
  emailSubject       String?
  emailDate          DateTime
  originalEmail      String?
  aiConfidence       Float               @default(0.0)
  detectedChanges    Json?
  needsEmailResponse Boolean             @default(false)
  status             FlaggedItemStatus   @default(PENDING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  reviewedAt         DateTime?
  mlFeedback         MLFeedbackType?
  userNotes          String?
  projectId          String
  emailContext       String?
  emailMessages      EmailMessage[]
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timelineEntry      TimelineEntry?

  @@map("flagged_items")
}

model TimelineEntry {
  id             String           @id @default(cuid())
  title          String
  description    String
  category       TimelineCategory
  date           DateTime
  impact         String?
  cost           Float?
  scheduleImpact String?
  scopeDetails   String?
  verified       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  projectId      String
  flaggedItemId  String?          @unique
  flaggedItem    FlaggedItem?     @relation(fields: [flaggedItemId], references: [id])
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("timeline_entries")
}

model EmailSettings {
  id                           String    @id @default(cuid())
  gmailConnected               Boolean   @default(false)
  gmailRefreshToken            String?
  gmailAccessToken             String?
  gmailTokenExpiry             DateTime?
  monitoringEnabled            Boolean   @default(true)
  emailFilters                 Json?
  notificationsEnabled         Boolean   @default(true)
  weeklyReports                Boolean   @default(true)
  highPriorityAlerts           Boolean   @default(true)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  projectId                    String    @unique
  oauthComplianceData          Json?
  oauthGrantedAt               DateTime?
  oauthGrantedBy               String?
  oauthLastRefreshedAt         DateTime?
  oauthReauthorizationRequired Boolean   @default(false)
  oauthRevokeReason            String?
  oauthRevokedAt               DateTime?
  oauthRevokedBy               String?
  oauthScopes                  Json?
  oauthSessionId               String?
  project                      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("email_settings")
}

model EmailMessage {
  id                String          @id @default(cuid())
  messageId         String          @unique
  threadId          String?
  provider          String          @default("gmail")
  providerData      Json?
  subject           String?
  sender            String
  senderName        String?
  recipients        String[]
  ccRecipients      String[]
  bccRecipients     String[]
  sentAt            DateTime
  receivedAt        DateTime        @default(now())
  bodyText          String?
  bodyHtml          String?
  s3ContentPath     String?
  s3AttachmentPaths String[]
  ingestionStatus   String          @default("pending")
  analysisStatus    String          @default("pending")
  assignmentStatus  String          @default("pending")
  relevanceScore    Float?
  aiSummary         String?
  classification    Json?
  extractedData     Json?
  urgencyLevel      String?
  flaggedItemId     String?
  containsChanges   Boolean         @default(false)
  processingErrors  Json?
  retryCount        Int             @default(0)
  lastProcessedAt   DateTime?
  userId            String
  projectId         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  emailAnalyses     EmailAnalysis[]
  flaggedItem       FlaggedItem?    @relation(fields: [flaggedItemId], references: [id])
  project           Project?        @relation(fields: [projectId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, receivedAt])
  @@index([projectId, receivedAt])
  @@index([ingestionStatus])
  @@index([analysisStatus])
  @@index([urgencyLevel])
  @@index([containsChanges])
  @@map("email_messages")
}

model EmailAnalysis {
  id                   String       @id @default(cuid())
  emailId              String
  projectId            String
  classification       String
  confidence           Float
  subCategories        String
  keyPoints            String
  actionItems          String
  timelineMentions     String
  entities             String
  priority             String
  requiresResponse     Boolean      @default(false)
  attachmentsMentioned Boolean      @default(false)
  confidenceScore      Float
  modelUsed            String
  processingTimeMs     Int
  analyzedAt           DateTime     @default(now())
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  email                EmailMessage @relation(fields: [emailId], references: [id], onDelete: Cascade)
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([emailId, projectId])
  @@map("email_analyses")
}

model OAuthSession {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  sessionContext    String
  sessionPurpose    String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  tokenType         String?   @default("Bearer")
  scopes            String[]
  isActive          Boolean   @default(true)
  lastUsedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  revokedAt         DateTime?
  revokedReason     String?
  deviceInfo        String?
  userAgent         String?
  ipAddress         String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, sessionContext])
  @@map("oauth_sessions")
}

model MLFeedback {
  id               String               @id @default(cuid())
  feedbackType     MLFeedbackType
  confidence       Float?
  userAction       String
  emailContent     String?
  detectedPatterns Json?
  correctCategory  FlaggedItemCategory?
  createdAt        DateTime             @default(now())
  flaggedItemId    String?
  projectId        String

  @@map("ml_feedback")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model TeamMember {
  id        String         @id @default(cuid())
  name      String
  email     String
  role      TeamMemberRole
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("team_members")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum FlaggedItemCategory {
  COST
  SCHEDULE
  SCOPE
  UNCLASSIFIED
}

enum FlaggedItemStatus {
  PENDING
  REVIEWED
  CONFIRMED
  IGNORED
  EMAIL_SENT
}

enum TimelineCategory {
  COST
  SCHEDULE
  SCOPE
  ISSUE
  UPDATE
}

enum MLFeedbackType {
  POSITIVE
  NEGATIVE
  RECLASSIFY
  CLASSIFY
}

enum TeamMemberRole {
  GENERAL_CONTRACTOR
  ARCHITECT_DESIGNER
  PROJECT_MANAGER
}
